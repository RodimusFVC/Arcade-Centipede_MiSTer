<misterromdescription>
    <name>Bulls Eye Darts</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Bulls Eye Darts</series>
    <year>1985</year>
    <manufacturer>Shinkai Inc. (Magic Electronics Inc. license)</manufacturer>
    <category>Shooter</category>

    <setname>bullsdrt</setname>
    <parent>bullsdrt</parent>
    <mameversion>0289</mameversion>
    <rbf>Centipede</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls>trackball</special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,00">
        <dip name="Unknown" bits="0" ids="Off,On" values="1,0"/>
        <dip name="Award Free Game" bits="1" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="2" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="5" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="6" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="7" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="9" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="10" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="11" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="12" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="13" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Unknown" bits="15" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx low plane 0x10000, gfx high plane 0x12000, sync PROM 0x14000, PROMs 0x14100 -->
    <rom index="0" md5="none" zip="bullsdrt.zip|centiped.zip">
        <part crc="2729f585" name="27128.bin" offset="0x0" length="0x1000"/>
        <part repeat="0x1000">00</part>
        <part crc="2729f585" name="27128.bin" offset="0x1000" length="0x1000"/>
        <part repeat="0x1000">00</part>
        <part crc="2729f585" name="27128.bin" offset="0x2000" length="0x1000"/>
        <part repeat="0x1000">00</part>
        <part crc="2729f585" name="27128.bin" offset="0x3000" length="0x1000"/>
        <part repeat="0x9000">00</part>
        <part crc="49a19aba" name="2764_b.bin"/>
        <part crc="361ff09d" name="2764_a.bin"/>
        <part crc="6fa3093a" name="136001-213.p4"/>
    </rom>

    <!-- Index 1: board variant, flags, port idle levels, input map (see Arcade-Centipede.sv) -->
    <rom index="1">
        <part>
            09 19 02 00 30 FF 70 FF FF FF 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 13 14 05 00 00 11 12 17
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            80 81 82 83 84 85 86 87 88 89 8A 8B 8C 8D 8E 8F
        </part>
    </rom>

    <!-- Index 4: the board's save chip (64 bytes), restored by the game itself -->
    <rom index="4"></rom>
    <nvram index="4" size="64"></nvram>

    <remark>Bulls Eye Darts (Shinkai Inc. (Magic Electronics Inc. License))</remark>
    <mratimestamp>20261012000000</mratimestamp>
</misterromdescription>
