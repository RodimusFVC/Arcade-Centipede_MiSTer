<misterromdescription>
    <name>Warlords</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Warlords</series>
    <year>1980</year>
    <manufacturer>Atari</manufacturer>
    <category>Shooter</category>

    <setname>warlords</setname>
    <parent>warlords</parent>
    <mameversion>0289</mameversion>
    <rbf>Centipede</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>4 (simultaneous)</players>
    <joystick>8-way</joystick>
    <special_controls>paddle</special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="02,02,00">
        <dip name="Diag Step" bits="0" ids="Off,On"/>
        <dip name="Service Mode" bits="1" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="2" ids="Upright (overlay),Cocktail (no overlay)" values="1,0"/>
        <dip name="Language" bits="3,4" ids="English,French,Spanish,German"/>
        <dip name="Music" bits="5" ids="End of game,High score only"/>
        <dip name="Credits" bits="6,7" ids="1p/2p = 1 credit,1p = 1; 2p = 2,1p/2p = 2 credits" values="0,1,2"/>
        <dip name="Coinage" bits="8,9" ids="2C/1C,1C/1C,1C/2C,Free Play" values="3,2,1,0"/>
        <dip name="Right Coin" bits="10,11" ids="*1,*4,*5,*6"/>
        <dip name="Left Coin" bits="12" ids="*1,*2"/>
        <dip name="Bonus Coins" bits="13,15" ids="None,3 credits/2 coins,5 credits/4 coins,6 credits/4 coins,6 credits/5 coins" values="0,1,2,3,4"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx low plane 0x10000, gfx high plane 0x12000, sync PROM 0x14000, color PROM 0x14100 -->
    <rom index="0" md5="none" zip="warlords.zip">
        <part repeat="0x5000">00</part>
        <part crc="18006c87" name="037154-01.m1"/>
        <part crc="67758f4c" name="037153-01.k1"/>
        <part crc="1f043a86" name="037158-01.j1"/>
        <part crc="1a639100" name="037157-01.h1"/>
        <part crc="534f34b4" name="037156-01.e1"/>
        <part crc="23b94210" name="037155-01.d1"/>
        <part repeat="0x8000">00</part>
        <part crc="ff979a08" name="037159-01.e6" offset="0x0" length="0x400"/>
        <part repeat="0x1C00">00</part>
        <part crc="ff979a08" name="037159-01.e6" offset="0x400" length="0x400"/>
        <part repeat="0x1C00">00</part>
        <part crc="6fa3093a" name="037161-01.m6"/>
        <part crc="a2c5c277" name="037235-01.n7"/>
    </rom>

    <!-- Index 1: board variant, flags, port idle levels, input map (see Arcade-Centipede.sv) -->
    <rom index="1">
        <part>
            07 0A 00 00 20 FF FF FF 00 02 00 00 00 00 00 00
            00 00 00 00 80 81 00 82 05 0D 18 19 15 11 12 16
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            83 84 85 00 86 87 00 00 88 89 8A 8B 8C 8D 8E 8F
        </part>
    </rom>

    <remark>Warlords (Atari)</remark>
    <mratimestamp>20261012000000</mratimestamp>
</misterromdescription>
