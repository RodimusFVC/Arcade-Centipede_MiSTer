<misterromdescription>
    <name>Maze Invaders</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Maze Invaders</series>
    <year>1981</year>
    <manufacturer>Atari</manufacturer>
    <category>Shooter</category>

    <setname>mazeinv</setname>
    <parent>mazeinv</parent>
    <mameversion>0289</mameversion>
    <rbf>Centipede</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls>analog stick</special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="P1 Fire,P1 Reverse,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="98,48,00">
        <dip name="Language" bits="0,1" ids="English,German,French,Spanish"/>
        <dip name="Minimum credits" bits="2" ids="1,2"/>
        <dip name="Cabinet" bits="3" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Service Mode" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Doors for bonus" bits="5,6" ids="10,12,14,16"/>
        <dip name="Lives" bits="7,8" ids="2,3,4,5"/>
        <dip name="Extra life at" bits="9,10" ids="20000,25000,30000,Never"/>
        <dip name="Difficulty" bits="11,12" ids="Easiest,Easy,Hard,Harder"/>
        <dip name="Coinage" bits="13,14" ids="2C/1C,1C/1C,1C/2C,Free Play" values="3,2,1,0"/>
        <dip name="Coin 2" bits="15,16" ids="*1,*4,*5,*6"/>
        <dip name="Coin 3" bits="17" ids="*1,*2"/>
        <dip name="Bonus Coins" bits="18,20" ids="None,3 credits/2 coins,5 credits/4 coins,6 credits/4 coins,6 credits/5 coins" values="0,1,2,3,4"/>
    </switches>

    <!-- Index 0: CPU 0x00000, gfx low plane 0x10000, gfx high plane 0x12000, sync PROM 0x14000, color PROM 0x14100 -->
    <rom index="0" md5="none" zip="mazeinv.zip">
        <part repeat="0x3000">00</part>
        <part crc="37129536" name="136011-005.p1"/>
        <part crc="2d0fbf2f" name="136011-004.mn1"/>
        <part crc="0ff3747c" name="136011-003.l1"/>
        <part crc="96478e07" name="136011-002.k1"/>
        <part crc="d5c29a01" name="136011-001.hj1"/>
        <part repeat="0x8000">00</part>
        <part crc="16e738f4" name="136011-007.hj6"/>
        <part repeat="0x1800">00</part>
        <part crc="d4705e4e" name="136011-006.f6"/>
        <part repeat="0x1800">00</part>
        <part crc="6fa3093a" name="136011-008.c10"/>
        <part crc="dcc48de5" name="136011-009.c11"/>
    </rom>

    <!-- Index 1: board variant, flags, port idle levels, input map (see Arcade-Centipede.sv) -->
    <rom index="1">
        <part>
            08 1C 00 00 00 FF FF FF 44 02 00 00 00 00 00 00
            80 81 00 00 00 00 82 00 00 00 00 00 00 00 00 00
            06 00 05 13 15 11 12 17 0E 00 0D 14 00 83 00 84
            85 86 87 88 89 8A 8B 8C 8D 8E 8F 90 91 92 93 94
        </part>
    </rom>

    <remark>Maze Invaders (Prototype) (Atari)</remark>
    <mratimestamp>20261012000000</mratimestamp>
</misterromdescription>
